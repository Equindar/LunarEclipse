{
  "name": "@lunareclipse/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch src/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node build/server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@lunareclipse/design": "workspace:*",
    "@lunareclipse/eslint": "workspace:*",
    "@lunareclipse/typescript": "workspace:*",
    "@lunareclipse/helpers": "workspace:*",
    "@lunareclipse/features": "workspace:*",
    "@lunareclipse/database": "workspace:*",
    "@lunareclipse/i18n": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
