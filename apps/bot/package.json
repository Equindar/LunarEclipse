{
  "name": "@lunareclipse/discordbot",
  "version": "1.0.0",
  "description": "A discord bot, written in typescript",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx --watch ./src/index.ts",
    "start": "node build/index.js",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --cache --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.24.0",
    "dotenv": "^17.4.2",
    "openai": "^6.34.0"
  },
  "devDependencies": {
    "@lunareclipse/eslint": "workspace:*",
    "@lunareclipse/typescript": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}