{
  "name": "@lunareclipse/discordbot",
  "version": "1.0.0",
  "description": "A discord bot, written in typescript",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx --watch ./src/index.ts",
    "start": "node build/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "check-types": "tsc --noEmit",
    "deploy-commands": "tsx ./src/scripts/deployCommands.ts",
    "deploy-commands:prod": "node build/scripts/deployCommands.js"
  },
  "dependencies": {
    "@lunareclipse/logging": "workspace:*",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@lunareclipse/eslint": "workspace:*",
    "@lunareclipse/typescript": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}