{
  "extends": "@lunareclipse/typescript/base.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "./build"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "build",
    "node_modules",
    "**/*.test.ts"
  ],
  /* Specify multiple folders that act like './node_modules/@types'. */
  "typeRoots": [
    "./node_modules/@types",
    "./node_modules/@discordjs/typings",
    "./src/types"
  ],
}