{
  "editor.formatOnSave": true,
  "editor.quickSuggestions": { "strings": "on" },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "js/ts.tsdk.path": "./node_modules/typescript/lib",

  "files.exclude": {
    "**/.turbo": true,
    "**/coverage": true
  },
  "search.exclude": {
    "**/.turbo": true,
    "**/build": true,
    "**/coverage": true
  },
  "files.watcherExclude": {
    "**/.turbo/**": true,
    "**/build/**": true,
    "**/coverage/**": true
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "json.schemaDownload.trustedDomains": {
    "https://turborepo.dev/": true
  },
  "tailwindCSS.classFunctions": ["tw", "cn"],
  "tailwindCSS.experimental.configFile": "packages/design/src/index.css",
}
