{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/api/build/index.js",
      "preLaunchTask": "build:api",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/api/build/**/*.js"
      ]
    },
    {
      "name": "Debug DiscordBot",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/bot/build/index.js",
      "preLaunchTask": "build:bot",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/bot/build/**/*.js"
      ]
    },
    {
      "name": "Debug DiscordBot [tsx]",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "tsx",
        "src/index.ts"
      ],
      "cwd": "${workspaceFolder}/apps/bot",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}