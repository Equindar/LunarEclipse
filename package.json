{
  "name": "lunareclipse",
  "version": "0.1.0",
  "description": "A browsergame, written in typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Equindar/LunarEclipse.git"
  },
  "author": "Equindar",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Equindar/LunarEclipse/issues"
  },
  "homepage": "https://github.com/Equindar/LunarEclipse#readme",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "turbo": "^2.9.9",
    "prettier": "3.4.2"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "config/*",
    "packages/*",
    "apps/*"
  ]
}